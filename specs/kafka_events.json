{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "KafkaEventSchemas",
  "description": "Contratos estritos para os eventos de mensageria publicados e consumidos no Apache Kafka.",
  "definitions": {
    "TransactionCreatedEvent": {
      "type": "object",
      "required": ["event_id", "event_type", "aggregate_id", "timestamp", "version", "data"],
      "properties": {
        "event_id": {
          "type": "string",
          "format": "uuid",
          "description": "Identificador único do evento para garantia de idempotência no Inbox."
        },
        "event_type": {
          "type": "string",
          "enum": ["TRANSACTION_CREATED"],
          "description": "Tipo do evento."
        },
        "aggregate_id": {
          "type": "string",
          "format": "uuid",
          "description": "Identificador da entidade transação (chave de particionamento)."
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp ISO-8601 da ocorrência do evento."
        },
        "version": {
          "type": "string",
          "enum": ["v1"],
          "description": "Versão do schema do evento."
        },
        "data": {
          "type": "object",
          "required": ["transaction_id", "customer_id", "value", "status"],
          "properties": {
            "transaction_id": {
              "type": "string",
              "format": "uuid"
            },
            "customer_id": {
              "type": "string"
            },
            "value": {
              "type": "number",
              "minimum": 0.01
            },
            "status": {
              "type": "string",
              "enum": ["PENDING"]
            }
          }
        }
      }
    },
    "TransactionStatusChangedEvent": {
      "type": "object",
      "required": ["event_id", "event_type", "aggregate_id", "timestamp", "version", "data"],
      "properties": {
        "event_id": {
          "type": "string",
          "format": "uuid"
        },
        "event_type": {
          "type": "string",
          "enum": ["TRANSACTION_STATUS_CHANGED"]
        },
        "aggregate_id": {
          "type": "string",
          "format": "uuid"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "version": {
          "type": "string",
          "enum": ["v1"]
        },
        "data": {
          "type": "object",
          "required": ["transaction_id", "customer_id", "old_status", "new_status"],
          "properties": {
            "transaction_id": {
              "type": "string",
              "format": "uuid"
            },
            "customer_id": {
              "type": "string"
            },
            "old_status": {
              "type": "string",
              "enum": ["PENDING", "PROCESSING", "RETRYING"]
            },
            "new_status": {
              "type": "string",
              "enum": ["APPROVED", "REJECTED", "RETRYING", "FAILED"]
            },
            "reason": {
              "type": ["string", "null"]
            }
          }
        }
      }
    },
    "KafkaMessageHeaders": {
      "type": "object",
      "properties": {
        "x-retry-count": {
          "type": "string",
          "pattern": "^[0-9]+$",
          "description": "Número de tentativas já realizadas para processamento."
        },
        "x-next-retry-timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp limite para aplicação do backoff exponencial."
        },
        "x-original-topic": {
          "type": "string",
          "description": "Tópico de origem antes do redirecionamento para retry/DLQ."
        },
        "x-exception-type": {
          "type": "string",
          "description": "Nome da classe da exceção que provocou a falha."
        }
      }
    }
  }
}
