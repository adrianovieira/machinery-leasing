name = "pypi"

[packages]
fastapi = {extras = [""], version = "~=0.142.2"}
uvicorn = {extras = ["standard"], version = "~=0.54.0"}
pydantic = "~=2.13.5"
pydantic-settings = "~=2.15.0"
sqlalchemy = "~=2.0.54"
alembic = "~=1.20.0"
